<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- CPU clusters: 0-3 efficiency, 4-7 performance -->
    <resource id="0x0002" name="cpu_max_little"
        path="/sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq"
        default="1900800" />
    <resource id="0x0003" name="cpu_max_big"
        path="/sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq"
        default="2400000" />
    <resource id="0x0004" name="cpu_min_little"
        path="/sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq"
        default="300000" />
    <resource id="0x0005" name="cpu_min_big"
        path="/sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq"
        default="300000" />

    <!-- Memory and interconnect -->
    <resource id="0x0006" name="cpu_bw_min"
        path="/sys/class/devfreq/soc:qcom,cpu-cpu-ddr-bw/min_freq"
        default="1525" />
    <resource id="0x0007" name="gpu_bus_min"
        path="/sys/class/devfreq/soc:qcom,gpubw/min_freq"
        default="0" />
    <resource id="0x000c" name="ddr_little_min"
        path="/sys/class/devfreq/soc:qcom,cpu0-cpu-ddr-lat/min_freq"
        default="1525" />
    <resource id="0x000d" name="ddr_big_min"
        path="/sys/class/devfreq/soc:qcom,cpu4-cpu-ddr-lat/min_freq"
        default="1525" />

    <!-- Qualcomm GPU controls -->
    <resource id="0x0008" name="gpu_min_freq"
        path="/sys/class/kgsl/kgsl-3d0/devfreq/min_freq"
        default="320000000" />
    <resource id="0x000a" name="gpu_force_rail"
        path="/sys/class/kgsl/kgsl-3d0/force_rail_on"
        default="0" />
    <resource id="0x000b" name="gpu_force_clk"
        path="/sys/class/kgsl/kgsl-3d0/force_clk_on"
        default="0" />

    <!-- PMQoS and uclamp; AxBurstEngine maps these to legacy stune -->
    <resource id="0x0011" name="pmqos_cpu_dma_latency"
        path="/dev/cpu_dma_latency"
        default="100" />
    <resource id="0x0012" name="uclamp_fg_min"
        path="/dev/cpuctl/foreground/cpu.uclamp.min"
        default="0" />
    <resource id="0x0013" name="uclamp_top_lat"
        path="/dev/cpuctl/top-app/cpu.uclamp.latency_sensitive"
        default="0" />
    <resource id="0x0014" name="uclamp_top_min"
        path="/dev/cpuctl/top-app/cpu.uclamp.min"
        default="0" />
    <resource id="0x0015" name="uclamp_fg_lat"
        path="/dev/cpuctl/foreground/cpu.uclamp.latency_sensitive"
        default="0" />

    <!-- CPU sets -->
    <resource id="0x0099" name="cpuset_bg"
        path="/dev/cpuset/background/cpus"
        default="0-5" />
    <resource id="0x009a" name="cpuset_fg"
        path="/dev/cpuset/foreground/cpus"
        default="0-7" />
    <resource id="0x009b" name="cpuset_dex2oat"
        path="/dev/cpuset/dex2oat/cpus"
        default="0-5" />
</resources>
